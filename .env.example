# Copy to .env.local for local development. npm run dev, npm start and scripts/compare-evaluators.ts read it.
# The partner scoping assistant and the student Reflection Companion. Set ONE of these.
# Direct Anthropic key:
ANTHROPIC_API_KEY=
# Or Vercel AI Gateway (on Vercel, the project OIDC token works without a key). Needed for Gemma:
AI_GATEWAY_API_KEY=

# Reflection Companion model (docs/gemma-prototype.md). Unset or "claude" = Claude Sonnet 5.5.
# "gemma-gateway" = Gemma 4 through the Vercel AI Gateway (a hosted service, not local).
EVALUATOR_PROVIDER=
# Optional Gemma model ID, e.g. google/gemma-4-26b-a4b-it (default google/gemma-4-31b-it)
EVALUATOR_MODEL=
# Not built yet: "gemma-local" (Ollama or vLLM) would use these.
# EVALUATOR_BASE_URL=http://localhost:11434/v1
# EVALUATOR_API_KEY=
