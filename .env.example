# Copy to .env.local for local development. npm run dev, npm start and scripts/compare-evaluators.ts read it.
# `npm run keys -- setup <provider>` fills this in for you with hidden input. Never commit .env.local.

# The partner scoping assistant and the student Reflection Companion (the default). Direct Anthropic key:
ANTHROPIC_API_KEY=

# Reflection Companion model (docs/gemma-prototype.md). Unset or "claude" = Claude Sonnet 5.5.
#   gemma-local       Gemma 4 on your own Ollama, LM Studio or llama.cpp server. No paid key; data stays on your machine.
#   gemma-google      Google AI Studio free tier. May use inputs to improve Google's products: synthetic examples only.
#   gemma-openrouter  OpenRouter. The ":free" model has the same caveat; EVALUATOR_MODEL=google/gemma-4-31b-it is paid.
#   gemma-gateway     Vercel AI Gateway. Available, but not pursued for now.
EVALUATOR_PROVIDER=
# Optional model ID. Defaults: gemma4:12b (local), gemma-4-31b-it (Google), google/gemma-4-31b-it:free (OpenRouter).
EVALUATOR_MODEL=

# gemma-local: the server's OpenAI-compatible URL, e.g. http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio).
EVALUATOR_BASE_URL=
# Only if your server asks for one, e.g. the secret you chose with vLLM's --api-key.
EVALUATOR_API_KEY=

# Free tiers stay off until you confirm every input is synthetic: set EVALUATOR_FREE_TIER=synthetic-only.
EVALUATOR_FREE_TIER=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Vercel AI Gateway (not pursued for now). On Vercel, the project's OIDC token works without a key.
AI_GATEWAY_API_KEY=
