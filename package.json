    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.3"
