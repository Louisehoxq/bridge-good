    "@tanstack/react-query": "^5.104.1",
    "@vercel/react-router": "^1.3.7",
    "ai": "^7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.18.4",
